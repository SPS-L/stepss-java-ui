                <Component class="javax.swing.JComboBox" name="runtimeObsType">
                  <Properties>
                    <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Click to choose the kind of observable you want to see in run-time during the simulation&lt;/html&gt;"/>
                    <Property name="name" type="java.lang.String" value="runtimeObsType" noResource="true"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JTextField" name="runtimeObsName">
                  <Properties>
                    <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Here you clarify the name of the equipment you want to observe. For example:&lt;br&gt;&#xa;1) if you selected Bus Voltage as the type of observable, here you should put the name of the bus.&lt;br&gt;&#xa;2) if you selected Machine Speed or Center of Inertia as the type of observable, here you should put the name of the synchronous machine.&lt;br&gt;&#xa;3) if you selected Wall Time as the type of observable, here you should put RT, as it will plot wall time VS Simulation time.&lt;br&gt;&#xa;4) if you selected Injector Observable or Two-port injector Observable, put two names: the equipment, then the observable within its model, separated by a space.&lt;/html&gt;"/>
                    <Property name="name" type="java.lang.String" value="runtimeObsName" noResource="true"/>
                  </Properties>
                </Component>
