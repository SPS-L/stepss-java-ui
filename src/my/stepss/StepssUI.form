                  </Events>
                </Component>
                <Component class="javax.swing.JButton" name="loadObsButton">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="Load file"/>
                    <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Click to load the file with the list of observables to be saved during the simulation.&lt;br&gt;&lt;br&gt;&#xa;Each observable needs to be on one line. The possibilities are: &lt;br&gt;&#xa;BUS: followed by one bus name or * to denote all buses &lt;br&gt;&#xa;SYNC: followed by one synchronous machine name or * to denote all sync machines&lt;br&gt;&#xa;SHUNT: followed by a bus name or * to denote all buses&lt;br&gt;&#xa;BRANCH: followed by the branch name or * to denote all branches&lt;br&gt;&#xa;INJEC: followed by the injector name or * to denote all injectors&lt;br&gt;&#xa;LINK: followed by the dclink name or * to denote all dclinks&lt;br&gt;&lt;br&gt;&#xa;An example of an observable file is:&lt;br&gt;&lt;br&gt;&#xa;BUS B01 &lt;br&gt;&#xa;SYNC SM01 &lt;br&gt;&#xa;SYNC SM02 &lt;br&gt;&#xa;SYNC SM03 &lt;br&gt;&#xa;BRANCH *&lt;br&gt;&lt;br&gt;&#xa;which will save BUS B01 observables, synchronous machines SM01, SM02 and SM03 and all the branches observables.&lt;/html&gt;"/>
                    <Property name="name" type="java.lang.String" value="loadObsButton" noResource="true"/>
                  </Properties>
                  <Events>
                    <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="loadObsButtonActionPerformed"/>
                  </Events>
                </Component>
                <Component class="javax.swing.JTextField" name="fileObs">
