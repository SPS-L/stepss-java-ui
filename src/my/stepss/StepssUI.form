                <Component class="javax.swing.JCheckBox" name="saveOutputTrajButton">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="Save output trajectory"/>
                    <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Click to save the trajectories of certain observables during the simulation. &lt;br&gt;&#xa;These observables need to be specified in a file and loaded below or with the Observable File Wizard.&lt;/html&gt;"/>
                    <Property name="name" type="java.lang.String" value="saveOutputTrajButton" noResource="true"/>
                  </Properties>
                  <Events>
