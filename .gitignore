/build/
/dist/

# jpackage output (ant bundle)
/bundle/

# Fetched release payloads (see versions.properties)
/payload-cache/

# Staged build inputs copied from payload-cache/ (see build.xml stage-payloads)
/src/my/stepss/payload/
