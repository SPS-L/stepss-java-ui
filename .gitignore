# Local Claude Code / MCP configuration
/.claude/
# Unanchored too: the leading slash above matches only a .claude at the
# repository root, and a nested src/my/stepss/.claude/ was slipping past
# it and into the built jar as a resource.
.claude/
.mcp.json
/.superpowers/

# NetBeans per-user state: compile-on-save flags, the last profiler
# configuration, local paths. Machine specific, never the project's.
/nbproject/private/

# Ant build outputs
/build/
/dist/

# Bytecode cache from running the release tooling and its tests
__pycache__/

# jpackage output (ant bundle)
/bundle/

# Fetched release payloads (see versions.properties)
/payload-cache/

# Staged build inputs copied from payload-cache/ (see build.xml stage-payloads)
/src/my/stepss/payload/
